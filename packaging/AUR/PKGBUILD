# herdr-screen: GNU screen edition of Herdr (source build for Arch and derivatives)
#
# Build it yourself - no AUR account or registration needed:
#   pacman -S rust zig        # extra/zig 0.16.0 is what the vendored terminal needs
#   makepkg -si
#
# The packages workflow builds this same PKGBUILD in an Arch container and
# attaches herdr-screen-<version>-1-x86_64.pkg.tar.zst to every release, so
# users can also install the prebuilt package directly. The same PKGBUILD is
# what an AUR submission would use, once there is an account to submit from.
pkgname=herdr-screen
pkgver=0.2.4
pkgrel=1
pkgdesc="GNU screen edition of the Herdr terminal workspace manager (source build)"
arch=('x86_64')
url="https://github.com/sadsfae/herdr-screen"
license=('Apache-2.0')
depends=('git' 'openssh' 'curl')
makedepends=('rust' 'zig')
source=("herdr-screen-main.tar.gz::https://github.com/sadsfae/herdr-screen/archive/refs/heads/main.tar.gz")
# Rolling main snapshot: the release CI builds and verifies the same tree, and
# release assets ship a SHA256SUMS for the tag snapshot.
sha256sums=('SKIP')

pkgver() {
  # Follow the release cadence (0.2.4 from a v0.2.4-<sha> tag). The CI pins an
  # explicit version through PKGVER_OVERRIDE so the built artifact matches the
  # release it is attached to.
  if [[ -n "$PKGVER_OVERRIDE" ]]; then
    printf '%s\n' "$PKGVER_OVERRIDE"
    return
  fi
  latest="$(curl -fsSL -o /dev/null -w '%{url_effective}' \
    https://github.com/sadsfae/herdr-screen/releases/latest)"
  tag="${latest##*/}"
  printf '%s\n' "${tag#v}" | sed 's/-[0-9a-f]\{7,\}$//'
}

build() {
  cd herdr-screen-main
  cargo build --release --locked
}

package() {
  install -Dm755 herdr-screen-main/target/release/herdr-screen "$pkgdir/usr/bin/herdr-screen"
  install -Dm644 herdr-screen-main/LICENSE "$pkgdir/usr/share/licenses/herdr-screen/LICENSE"
}
